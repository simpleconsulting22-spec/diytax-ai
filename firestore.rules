rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    //
    // Shared-access model:
    //   users/{ownerUid}.sharedUids  = string[]  — flat uid list for hasAny check
    //   users/{ownerUid}.sharedRoles = map        — { [uid]: "spouse"|"accountant" }
    //
    // Both fields are maintained by the acceptInvite Cloud Function.

    function ownerDoc(ownerUid) {
      return get(/databases/$(database)/documents/users/$(ownerUid));
    }

    // Second factor, carried in the ID token as a custom claim set by
    // verifyMfaCode.
    //
    // MFA used to exist only as React state restored from localStorage: the
    // modal gated the UI and nothing else. Any caller holding a valid ID token
    // — the SDK from a console, curl against the REST API, a stolen session —
    // reached every document without ever seeing it. The claim moves the
    // signal somewhere the client cannot write and the rules can read.
    //
    // Freshness is checked here rather than trusted from issuance, so a token
    // minted long ago stops satisfying it without needing revocation.
    function hasFreshMfa() {
      return request.auth != null
          && request.auth.token.mfaVerifiedAt is number
          && request.time.toMillis() - request.auth.token.mfaVerifiedAt < 86400000;
    }

    // Owners must have passed MFA. Shared users deliberately do not: they hold
    // their own Firebase credentials and never enrol (AuthGuard prompts only
    // for owners), so requiring it here would lock every spouse and accountant
    // out of the account entirely.
    function isOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid && hasFreshMfa();
    }

    function isSharedUser(ownerUid) {
      let od = ownerDoc(ownerUid);
      return request.auth != null
          && od.data.sharedUids != null
          && od.data.sharedUids.hasAny([request.auth.uid]);
    }

    function sharedRole(ownerUid) {
      let od = ownerDoc(ownerUid);
      return od.data.sharedRoles != null
           ? od.data.sharedRoles[request.auth.uid]
           : null;
    }

    // Any owner or shared user may read.
    function canRead(ownerUid) {
      return isOwner(ownerUid) || isSharedUser(ownerUid);
    }

    // Fields an accountant is allowed to change on an existing transaction.
    function accountantTxnKeys() {
      return [
        'category', 'taxCategory', 'taxSchedule',
        'entityId', 'entityName', 'entityType',
        'notes',
        'categorizationSource', 'categorizationConfidence', 'categorizationExplanation',
        'isUserModified', 'aiSuggested', 'aiSource',
        'updatedBy', 'updatedByRole', 'updatedAt'
      ];
    }

    // Owners and spouses: full write.
    // Accountants: only the fields listed above.
    function canUpdateTransaction(ownerUid) {
      return isOwner(ownerUid)
          || (isSharedUser(ownerUid) && sharedRole(ownerUid) == 'spouse')
          || (isSharedUser(ownerUid) && sharedRole(ownerUid) == 'accountant'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(accountantTxnKeys()));
    }

    // Generic write helper for non-transaction collections (no field restrictions).
    function canWrite(ownerUid) {
      return isOwner(ownerUid)
          || (isSharedUser(ownerUid) && sharedRole(ownerUid) == 'spouse');
    }

    // Only owners may delete or run destructive ops.
    function canDelete(ownerUid) {
      return isOwner(ownerUid);
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    // Each user can only read/write their own doc.
    // Cloud Functions (admin SDK) write sharedAccess/sharedUids/sharedRoles
    // and ownerUid/role when invites are accepted — no client rule needed.

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Transactions ──────────────────────────────────────────────────────────

    match /transactions/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow update: if canUpdateTransaction(resource.data.uid);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.uid)
                        || (isSharedUser(request.resource.data.uid)
                            && sharedRole(request.resource.data.uid) == 'spouse'));
      allow delete: if canDelete(resource.data.uid);
    }

    // ── Accounts ──────────────────────────────────────────────────────────────

    match /accounts/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow update: if canWrite(resource.data.uid);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.uid)
                        || (isSharedUser(request.resource.data.uid)
                            && sharedRole(request.resource.data.uid) == 'spouse'));
      allow delete: if canDelete(resource.data.uid);
    }

    // ── Category Rules ────────────────────────────────────────────────────────
    // Accountants can create rules (they edit categories/assignments).

    match /categoryRules/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow create: if request.auth != null && isSharedUser(request.resource.data.uid)
                    || request.auth != null && isOwner(request.resource.data.uid);
      allow update: if canWrite(resource.data.uid);
      allow delete: if canDelete(resource.data.uid);
    }

    // ── Recurring Items ──────────────────────────────────────────────────────
    // Written by the detectRecurring Cloud Function (admin SDK, bypasses rules).
    // Read by the Money Coach page client-side. No client writes.

    match /recurringItems/{doc} {
      allow read:  if canRead(resource.data.uid);
      allow write: if false;
    }

    // ── Type Rules ────────────────────────────────────────────────────────────
    // Frontend-only learning loop: when the user confirms a type pattern in
    // the CSV / AI parser preview, a doc is written here keyed by extracted
    // vendor. Future imports read these to pre-fill types in the preview.
    // Same access model as categoryRules: owner + spouse can read/write,
    // owner-only delete. No accountant write — these reflect the owner's
    // personal categorization habits.

    match /typeRules/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.uid)
                        || (isSharedUser(request.resource.data.uid)
                            && sharedRole(request.resource.data.uid) == 'spouse'));
      allow update: if canWrite(resource.data.uid);
      allow delete: if canDelete(resource.data.uid);
    }

    // ── Entities ──────────────────────────────────────────────────────────────
    // Accountants cannot create or delete entities.

    match /entities/{doc} {
      allow read:   if canRead(resource.data.userId);
      allow update: if canWrite(resource.data.userId);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.userId)
                        || (isSharedUser(request.resource.data.userId)
                            && sharedRole(request.resource.data.userId) == 'spouse'));
      allow delete: if canDelete(resource.data.userId);
    }

    // ── Tax Profiles ──────────────────────────────────────────────────────────

    match /taxProfiles/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow update: if canWrite(resource.data.uid);
      allow create: if request.auth != null && isOwner(request.resource.data.uid);
      allow delete: if canDelete(resource.data.uid);
    }

    // ── Tax Sessions ──────────────────────────────────────────────────────────

    match /taxSessions/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow update: if canWrite(resource.data.uid);
      allow create: if request.auth != null && isOwner(request.resource.data.uid);
      allow delete: if canDelete(resource.data.uid);
    }

    // ── User Profiles ─────────────────────────────────────────────────────────

    match /userProfiles/{doc} {
      allow read:   if canRead(resource.data.userId);
      allow update: if canWrite(resource.data.userId);
      allow create: if request.auth != null && isOwner(request.resource.data.userId);
      allow delete: if canDelete(resource.data.userId);
    }

    // ── Budgets ───────────────────────────────────────────────────────────────

    match /budgets/{doc} {
      allow read:   if canRead(resource.data.userId);
      allow update: if canWrite(resource.data.userId);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.userId)
                        || (isSharedUser(request.resource.data.userId)
                            && sharedRole(request.resource.data.userId) == 'spouse'));
      allow delete: if canDelete(resource.data.userId);
    }

    // ── Deductions ────────────────────────────────────────────────────────────

    match /deductions/{doc} {
      allow read:   if canRead(resource.data.userId);
      allow update: if canWrite(resource.data.userId);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.userId)
                        || (isSharedUser(request.resource.data.userId)
                            && sharedRole(request.resource.data.userId) == 'spouse'));
      allow delete: if canDelete(resource.data.userId);
    }

    // ── SSA Forms (SSA-1099 benefit entries) ──────────────────────────────────
    // Client-managed from /income/ssa. Keyed by `userId`, matching the
    // hook and the composite index in firestore.indexes.json.

    match /ssaForms/{doc} {
      allow read:   if canRead(resource.data.userId);
      allow update: if canWrite(resource.data.userId);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.userId)
                        || (isSharedUser(request.resource.data.userId)
                            && sharedRole(request.resource.data.userId) == 'spouse'));
      allow delete: if canDelete(resource.data.userId);
    }

    // ── Retirement Forms (1099-R distribution entries) ────────────────────────
    // Client-managed from /income/retirement. Keyed by `userId`.

    match /retirementForms/{doc} {
      allow read:   if canRead(resource.data.userId);
      allow update: if canWrite(resource.data.userId);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.userId)
                        || (isSharedUser(request.resource.data.userId)
                            && sharedRole(request.resource.data.userId) == 'spouse'));
      allow delete: if canDelete(resource.data.userId);
    }

    // ── Planned Bills ─────────────────────────────────────────────────────────
    // Manually entered upcoming bills on /spending-forecast. Keyed by `uid`
    // (note: written with the caller's own uid, not the effective owner's, so
    // a shared user's planned bills are their own).

    match /plannedBills/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow update: if canWrite(resource.data.uid);
      allow create: if request.auth != null
                    && (isOwner(request.resource.data.uid)
                        || (isSharedUser(request.resource.data.uid)
                            && sharedRole(request.resource.data.uid) == 'spouse'));
      allow delete: if canDelete(resource.data.uid);
    }

    // ── Imports ───────────────────────────────────────────────────────────────
    // Accountants cannot import data.

    match /imports/{doc} {
      allow read:          if canRead(resource.data.userId);
      allow create, update: if request.auth != null
                            && (isOwner(request.resource.data.userId)
                                || (isSharedUser(request.resource.data.userId)
                                    && sharedRole(request.resource.data.userId) == 'spouse'));
      allow delete:        if canDelete(resource.data.userId);
    }

    // ── Custom Categories ─────────────────────────────────────────────────────
    // Accountants can add categories (needed when saving edits).

    match /categories/{doc} {
      allow read:   if canRead(resource.data.uid);
      allow create: if request.auth != null && isSharedUser(request.resource.data.uid)
                    || request.auth != null && isOwner(request.resource.data.uid);
      allow update: if canWrite(resource.data.uid);
      allow delete: if canDelete(resource.data.uid);
    }

    // ── Invites ───────────────────────────────────────────────────────────────
    // Written by Cloud Functions (admin SDK) only.
    // Invited users may read their own invite to display invite details.

    match /invites/{doc} {
      // Reads require an authenticated owner or invited address — never the
      // invite ID alone.
      //
      // `allow read` authorizes list queries as well as single-document gets,
      // and the condition is evaluated per candidate document. A rule that let
      // pending invites through unauthenticated therefore did not just expose
      // a doc to whoever held its ID: an anonymous client could run
      // `where("status", "==", "pending")` and page through every outstanding
      // invite in the database, each one carrying the invited person's email
      // address, the owner's uid, and — as the document ID — the token that
      // acceptInvite consumes. Treating the ID as a secret does not hold when
      // the collection can be enumerated.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ownerUid
                      || request.auth.token.email == resource.data.email);
      allow write: if false;
    }

    // ── Notification History ──────────────────────────────────────────────────
    // Written by Cloud Functions (admin SDK) only; owners may read their own history.

    match /notificationHistory/{doc} {
      allow read:  if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // ── Blocked ───────────────────────────────────────────────────────────────

    match /userSecurity/{uid} {
      allow read, write: if false;
    }

    match /mail/{doc} {
      allow read, write: if false;
    }
  }
}
