# Copy this file to `functions/.env` and fill in real values.
# `functions/.env` is gitignored and must never be committed.
#
# This file holds NON-SENSITIVE configuration only. Every credential now lives
# in Firebase Secret Manager — see the bottom of this file and
# docs/SECURITY_ROTATION.md.

# ── Plaid ────────────────────────────────────────────────────────────────────
# Client ID is an account identifier, not an authentication credential: it
# cannot authenticate without PLAID_SECRET, which is a managed secret.
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://example.invalid/plaidWebhook
PLAID_REDIRECT_URI=https://example.invalid/bank-accounts

# ── Application ──────────────────────────────────────────────────────────────
APP_URL=https://example.invalid

# ── Amazon SES ───────────────────────────────────────────────────────────────
# Region is non-sensitive. It must match the region in which diytaxai.com is
# verified as an SES identity.
AWS_SES_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — do NOT add these here.
#
# These are declared per-function via `secrets: [...]` and stored in Firebase
# Secret Manager. Adding one to this file (or to functions/.env) would place the
# plaintext into the Cloud Run environment, where anyone with project read
# access can recover it via `gcloud run services describe` — which is exactly
# what the migration to Secret Manager removes.
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set PLAID_SECRET
#   firebase functions:secrets:set AWS_SES_ACCESS_KEY_ID
#   firebase functions:secrets:set AWS_SES_SECRET_ACCESS_KEY
#
# OPENAI_API_KEY is intentionally absent. Four functions still read it and log
# "OPENAI_API_KEY not set, skipping AI categorization" when it is missing — which
# is the current production state, and has been for months. AI categorization,
# receipt extraction, and quick-capture suggestions are therefore inactive.
# The plan is to move those call sites onto Claude Haiku 4.5 using the existing
# ANTHROPIC_API_KEY rather than opening an OpenAI account.
#
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_VERIFY_SERVICE_SID are
# intentionally absent: no source file reads them. The SMS path was never built.
# Delete them from functions/.env after rotating the auth token.
#
# SENDGRID_API_KEY / SENDGRID_FROM_EMAIL are intentionally absent: the SendGrid
# integration was removed. Delete SENDGRID_FROM_EMAIL from functions/.env.
# ─────────────────────────────────────────────────────────────────────────────
